# ══════════════════════════════════════════════════════════════════════════════
# UVerify Sandbox — Environment Configuration
#
# Copy this file to .env before running ./start.sh:
#   cp .env.example .env
#
# ⚠️  The mnemonic phrases below are SANDBOX-ONLY test wallets.
#     They are publicly known. NEVER use them on mainnet or preprod.
# ══════════════════════════════════════════════════════════════════════════════

PORT=9090
SPRING_ACTIVE_PROFILES=devnet,postgres

PROTOCOL_MAGIC=42
REMOTE_NODE_URL=yano
REMOTE_NODE_PORT=13337

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/uverify
DB_USERNAME=uverify
DB_PASSWORD=sandbox_password

# ── Cardano network ───────────────────────────────────────────────────────────
# 'PREPROD' keeps testnet address encoding (network ID 0), which is also used
# by the local YACI DevKit devnet.
CARDANO_NETWORK=PREPROD

# ── Cardano backend (YACI DevKit Blockfrost-compatible API) ───────────────────
# The backend uses this to query UTxOs and submit transactions.
# The YACI DevKit container exposes a Blockfrost-compatible REST API on port 8090.
CARDANO_BACKEND_TYPE=blockfrost
BLOCKFROST_PROJECT_ID=localtest
BLOCKFROST_BASE_URL=http://yano:7070/api/v1/

# Separate read-only backend for UTxO queries — the standalone Yaci Store
# correctly implements the address+unit UTxO endpoint that Yano does not.
# Transaction submission still goes through Yano (BLOCKFROST_BASE_URL).
CARDANO_QUERY_BASE_URL=http://yaci-store:8080/api/v1/
CARDANO_QUERY_PROJECT_ID=localtest

# ── Service account ───────────────────────────────────────────────────────────
# Pays for the INIT and library-deploy transactions during bootstrap.
# SERVICE_USER_ADDRESS is derived from the mnemonic and filled in automatically
# by bootstrap.ts on the first run. Leave it blank initially.

# ── Faucet ────────────────────────────────────────────────────────────────────
# The backend faucet funds example wallets on their first run.
# No real ADA involved — funded by the YACI DevKit devnet.
FAUCET_ENABLED=true
FAUCET_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon art

# ── Proxy contract reference ──────────────────────────────────────────────────
# Left blank on first run. bootstrap.ts populates these automatically after
# the INIT transaction is submitted and the backend is restarted.
PROXY_TX_HASH=0491da81bf693353a00b04d4006a6f133ebd6fa5ae938d8a8c3f84cfa48a7ed2
PROXY_OUTPUT_INDEX=0

CONNECTED_GOODS_EXTENSION_ENABLED=false

CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── YACI Store sync ───────────────────────────────────────────────────────────
# Sync settings (slot, hash, protocol-magic) are configured in
# application-devnet.yml — do not override here.
YACI_STORE_AUTO_START=true
